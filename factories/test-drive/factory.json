{
  "description": "The leadership test drive. Anyone in the sandbox project files an issue labelled `factory`; agents write the requirements, plan, and build in a maker-checker loop; the issue shows progress as it goes; a preview link lets the person try the change before approving; approval opens a merge request.",
  "source": {
    "type": "gitlab",
    "host": "gitlab.justpush.cloud",
    "project": "sandbox/test-drive-app",
    "label": "factory",
    "approvers": [
      "*"
    ],
    "progress": true,
    "write": true
  },
  "auto": true,
  "spec_dir": "specs/{n}-{slug}",
  "limits": {
    "max_attempts": 3
  },
  "build_skills": [
    "build-ui-logic",
    "build-ui-view",
    "build-ui-page",
    "build-tests",
    "check-tasks",
    "check-visual"
  ],
  "stages": [
    {
      "id": "read-issue",
      "by": "script",
      "skill": "read-issue",
      "intake": true
    },
    {
      "id": "requirements",
      "by": "agent",
      "skill": "write-requirements",
      "agent": "spec",
      "writes": [
        "{spec}/requirements.md"
      ],
      "produces": [
        "{spec}/requirements.md"
      ]
    },
    {
      "id": "visual-spec",
      "by": "agent",
      "skill": "write-visual-spec",
      "agent": "spec",
      "when_file": "{checkout}/{spec}/reference",
      "writes": [
        "{spec}/visual-spec.md",
        "{spec}/reference/"
      ],
      "produces": [
        "{spec}/visual-spec.md"
      ]
    },
    {
      "id": "approve-requirements",
      "by": "human"
    },
    {
      "id": "tasks",
      "by": "agent",
      "skill": "write-tasks",
      "agent": "spec",
      "writes": [
        "{spec}/"
      ],
      "produces": [
        "{spec}/tasks.md"
      ]
    },
    {
      "id": "lint-tasks",
      "by": "script",
      "skill": "lint-tasks",
      "on_fail": "tasks",
      "run": [
        "python3",
        "{scripts}/lint_tasks.py",
        "{checkout}/{spec}/tasks.md",
        "--skills-dir",
        "{skills}",
        "--skills-dir",
        "{checkout}/.claude/skills"
      ]
    },
    {
      "id": "build",
      "by": "agent",
      "skill": "build-tasks",
      "agent": "builder",
      "until": "all-tasks-ticked",
      "checker": {
        "agent": "checker",
        "skill": "check-tasks"
      }
    },
    {
      "id": "check-evidence",
      "by": "script",
      "skill": "check-evidence",
      "on_fail": "build",
      "run": [
        "python3",
        "{scripts}/check_evidence.py",
        "--spec",
        "{checkout}/{spec}",
        "--repo",
        "{checkout}",
        "--cat1"
      ]
    },
    {
      "id": "verify",
      "by": "script",
      "skill": "verify",
      "on_fail": "build",
      "run": [
        "{presubmit}"
      ]
    },
    {
      "id": "visual-verify",
      "by": "script",
      "skill": "visual-verify",
      "on_fail": "build",
      "commits": true,
      "error_code": 2,
      "run": [
        "python3",
        "{scripts}/visual_checks.py",
        "--spec",
        "{checkout}/{spec}",
        "--repo",
        "{checkout}"
      ]
    },
    {
      "id": "preview",
      "by": "script",
      "skill": "publish-preview",
      "run": [
        "python3",
        "{scripts}/preview_link.py",
        "--item",
        "{item}",
        "--target",
        "{name}"
      ]
    },
    {
      "id": "approve-screens",
      "by": "human",
      "baselines": true
    },
    {
      "id": "merge-request",
      "by": "script",
      "skill": "open-merge-request",
      "enabled": true,
      "run": [
        "python3",
        "{scripts}/open_merge_request.py",
        "--repo",
        "{checkout}",
        "--host",
        "{source_host}",
        "--project",
        "{source_project}",
        "--branch",
        "{branch}",
        "--target",
        "{main}",
        "--title",
        "{title}",
        "--spec",
        "{checkout}/{spec}",
        "--issue",
        "{issue}"
      ]
    }
  ]
}
