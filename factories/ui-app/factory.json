{
  "description": "UI work from GitLab issues. A visual spec pins every screen and state; a human looks at the result before it goes further.",
  "source": {
    "type": "gitlab",
    "host": "gitlab.com",
    "project": "<group>/<project>",
    "label": "factory"
  },
  "spec_dir": "specs/{n}-{slug}",
  "limits": {
    "max_attempts": 3
  },
  "build_skills": [
    "build-ui-logic",
    "build-ui-view",
    "build-ui-page",
    "build-tests",
    "check-tasks"
  ],
  "stages": [
    {
      "id": "read-issue",
      "by": "script",
      "skill": "read-issue",
      "intake": true
    },
    {
      "id": "requirements",
      "by": "agent",
      "skill": "write-requirements",
      "agent": "spec",
      "writes": [
        "{spec}/requirements.md"
      ],
      "produces": [
        "{spec}/requirements.md"
      ]
    },
    {
      "id": "approve-requirements",
      "by": "human"
    },
    {
      "id": "visual-spec",
      "by": "agent",
      "skill": "write-visual-spec",
      "agent": "spec",
      "optional": true,
      "writes": [
        "{spec}/visual-spec.md"
      ],
      "produces": [
        "{spec}/visual-spec.md"
      ]
    },
    {
      "id": "tasks",
      "by": "agent",
      "skill": "write-tasks",
      "agent": "spec",
      "writes": [
        "{spec}/"
      ],
      "produces": [
        "{spec}/tasks.md"
      ]
    },
    {
      "id": "lint-tasks",
      "by": "script",
      "skill": "lint-tasks",
      "on_fail": "tasks",
      "run": [
        "python3",
        "{scripts}/lint_tasks.py",
        "{checkout}/{spec}/tasks.md",
        "--skills-dir",
        "{skills}",
        "--skills-dir",
        "{checkout}/.claude/skills"
      ]
    },
    {
      "id": "build",
      "by": "agent",
      "skill": "build-tasks",
      "agent": "builder",
      "until": "all-tasks-ticked",
      "checker": {
        "agent": "checker",
        "skill": "check-tasks"
      }
    },
    {
      "id": "check-evidence",
      "by": "script",
      "skill": "check-evidence",
      "on_fail": "build",
      "run": [
        "python3",
        "{scripts}/check_evidence.py",
        "--spec",
        "{checkout}/{spec}",
        "--repo",
        "{checkout}",
        "--cat1"
      ]
    },
    {
      "id": "verify",
      "by": "script",
      "skill": "verify",
      "on_fail": "build",
      "run": [
        "{presubmit}"
      ]
    },
    {
      "id": "approve-screens",
      "by": "human"
    },
    {
      "id": "pull-request",
      "by": "script",
      "skill": "open-pull-request",
      "optional": true,
      "enabled": false,
      "run": [
        "python3",
        "{scripts}/open_pull_request.py",
        "--repo",
        "{checkout}",
        "--github",
        "{source_repo}",
        "--branch",
        "{branch}",
        "--target",
        "{main}",
        "--title",
        "{title}",
        "--spec",
        "{checkout}/{spec}",
        "--issue",
        "{issue}"
      ]
    },
    {
      "id": "merge-request",
      "by": "script",
      "skill": "open-merge-request",
      "optional": true,
      "enabled": false,
      "run": [
        "python3",
        "{scripts}/open_merge_request.py",
        "--repo",
        "{checkout}",
        "--host",
        "{source_host}",
        "--project",
        "{source_project}",
        "--branch",
        "{branch}",
        "--target",
        "{main}",
        "--title",
        "{title}",
        "--spec",
        "{checkout}/{spec}",
        "--issue",
        "{issue}"
      ]
    }
  ]
}
